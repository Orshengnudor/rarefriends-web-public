# Copy to .env.local. Never commit private environment files.
# Avoid duplicate variables across files: .env.local overrides .env.
# Server settings; do not prefix credentials with NEXT_PUBLIC_.
# Use your own Reown project and allow your application origins in its dashboard.
WALLETCONNECT_PROJECT_ID=

# Public contract addresses/ABIs for the protocol deployment.
# Set one inline format, or use a file path. Inline values take precedence.
PROTOCOL_DEPLOYMENT_GZIP_BASE64=
PROTOCOL_DEPLOYMENT_JSON=
PROTOCOL_DEPLOYMENT_FILE=
# Portfolio NFT discovery requires an Alchemy Robinhood endpoint.
# Example: https://robinhood-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# For Anvil (chain 31337), use http://127.0.0.1:8545 or a private LAN host.
PROTOCOL_RPC_URL=
# Wallet registration always uses the public Robinhood production RPC (chain 4663).
# Required for Anvil; use a local/LAN URL accessible from the browser.
# Example: http://127.0.0.1:8545. Leave empty for production.
PROTOCOL_PUBLIC_RPC_URL=

# Optional analytics, configured separately for each deployment.
GOOGLE_ANALYTICS_ID=

# User transactions are signed in the browser wallet.
# Do not configure deployer keys or seed phrases on the web server.

# Optional comma-separated hostnames/IPs allowed to load local dev assets.
DEV_ALLOWED_ORIGINS=
